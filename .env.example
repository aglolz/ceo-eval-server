# Copy of the production env var surface — see README "Environment variables"
# for full descriptions. On Railway these live in the service's Variables tab
# (Railway is the secret store); a local .env is only for running scripts like
# backfill_missing_calls.py. NEVER commit a real .env.

# ── Core ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude API key (read implicitly by the SDK — easy to miss when copying env)
ANTHROPIC_MODEL=claude-sonnet-4-6   # DO NOT change casually: judges are calibrated per-model
SUPABASE_URL=                 # https://<project>.supabase.co
SUPABASE_KEY=                 # anon key — full read/write here (RLS off); treat as secret
SUPABASE_TABLE=ceo_live_calls
VAPI_API_KEY=                 # transcript re-fetch when the webhook arrives without one

# ── A/B experiment ──────────────────────────────────────────────────────────
ARM_A_ASSISTANT_ID=           # Vapi assistant id, arm A
ARM_B_ASSISTANT_ID=           # Vapi assistant id, arm B
AB_FORCE_ARM=                 # "A" | "B" | empty — kill switch pinning all traffic to one arm

# ── SMS (summary mirror + feedback survey) ──────────────────────────────────
ZAPIER_SMS_HOOK_URL=          # summary-SMS relay; unset = no summary texts
FEEDBACK_SMS_ENABLED=         # "1" to enable the survey (default off)
SURVEY_DELAY_SEC=75
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=           # or TWILIO_MESSAGING_SERVICE_SID
# TWILIO_MESSAGING_SERVICE_SID=

# ── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_TOKEN=              # required; unset = dashboard refuses to serve. Also salts CEO-ID pseudonyms.
DASHBOARD_CACHE_SEC=120

# ── Simulation + tuning ─────────────────────────────────────────────────────
SIM_ASSISTANT_IDS=            # comma-separated assistantIds to divert to SIM_TABLE
SIM_TABLE=sim_calls
SCORING_WORKERS=4             # background scoring pool size

# ── Local-script-only (backfill_missing_calls.py) ───────────────────────────
# BACKFILL_SINCE=2026-07-28T00:04:37Z   # narrow the reconcile window on re-runs
